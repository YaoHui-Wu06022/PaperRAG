# MINERU配置
MINERU_API_KEY=
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=en

# 检索配置
SEMANTIC_SCHOLAR_DELAY_SECONDS=5
SEMANTIC_SCHOLAR_API_KEY=
ARXIV_DELAY_SECONDS=3
CROSSREF_DELAY_SECONDS=1
CROSSREF_MAILTO=

# Jev 有限集合路由
JEV_BASE_URL=https://jevmodel.org/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=20
JEV_MIN_CONFIDENCE=0.55

# Plan配置
PLAN_DENSE_TOP_K=20
PLAN_BM25_TOP_K=20
PLAN_FINAL_TOP_K=8
PLAN_BLOCK_WINDOW=2
PLAN_BM25_TRANSLATE_PROVIDERS=tencent,aliyun
PLAN_BM25_TRANSLATE_TIMEOUT_SECONDS=10

# DeepSeek 结构化抽取（仅本地 parser 失败时调用）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
EXTRACTION_CACHE_PATH=data/index/extraction_cache.jsonl

# 目录设置
PDF_DIR=data/pdf
MINERU_DIR=data/mineru_output
PAPER_DIR=data/paper_data

# Chunk配置
CHUNK_TARGET_CHARS=1400
CHUNK_OVERLAP_CHARS=200

# Milvus配置
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB_NAME=
MILVUS_COLLECTION=paper_rag_chunks

# Embedding配置
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_PROFILE=qwen_v4
EMBEDDING_FALLBACK_BASE_URL=
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_MODEL=
EMBEDDING_FALLBACK_DIM=0
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CACHE_PATH=data/index/embedding_cache.jsonl
QUERY_EMBEDDING_CACHE_PATH=data/index/query_embedding_cache.jsonl

# Agent/MCP 入库任务
MCP_JOB_LOG_PATH=data/index/mcp_jobs.jsonl
MCP_INDEX_STATE_PATH=data/index/index_state.json
PAPER_RAG_INPUT_ROOTS=
MCP_MAX_DOWNLOAD_MB=100

# BM25关键词翻译配置
TENCENT_TRANSLATE_SECRET_ID=
TENCENT_TRANSLATE_SECRET_KEY=
TENCENT_TRANSLATE_REGION=ap-shanghai
TENCENT_TRANSLATE_ENDPOINT=tmt.tencentcloudapi.com
ALIYUN_TRANSLATE_ACCESS_KEY_ID=
ALIYUN_TRANSLATE_ACCESS_KEY_SECRET=
ALIYUN_TRANSLATE_REGION=cn-hangzhou
ALIYUN_TRANSLATE_ENDPOINT=mt.aliyuncs.com
ALIYUN_TRANSLATE_VERSION=2018-10-12
