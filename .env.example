# MINERU配置
MINERU_API_KEY=
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=en

# 检索配置
DBLP_DELAY_SECONDS=1
DBLP_CANDIDATE_LIMIT=20
SEMANTIC_SCHOLAR_DELAY_SECONDS=5
SEMANTIC_SCHOLAR_API_KEY=
ARXIV_DELAY_SECONDS=3

# 翻译配置
BAIDU_TRANSLATE_APP_ID=
BAIDU_TRANSLATE_SECRET_KEY=
BAIDU_TRANSLATE_ENDPOINT=https://fanyi-api.baidu.com/api/trans/vip/fieldtranslate
BAIDU_TRANSLATE_DOMAIN=academic

# Plan配置
PLAN_DENSE_TOP_K=20
PLAN_BM25_TOP_K=20
PLAN_FINAL_TOP_K=8
PLAN_BLOCK_WINDOW=2

# Plan语义解析配置
PLAN_PARSER_BASE_URL=
PLAN_PARSER_API_KEY=
PLAN_PARSER_MODEL=
PLAN_PARSER_TIMEOUT_SECONDS=30

# 目录设置
PDF_DIR=data/pdf
MINERU_DIR=data/mineru_output
PAPER_DIR=data/paper_data

# Chunk配置
CHUNK_TARGET_CHARS=1400
CHUNK_OVERLAP_CHARS=200

# Milvus配置
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB_NAME=
MILVUS_COLLECTION=paper_rag_chunks

# Embedding配置
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CACHE_PATH=data/index/embedding_cache.jsonl
