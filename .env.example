# MINERU配置
MINERU_API_KEY=
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=en
MINERU_REQUEST_TIMEOUT_SECONDS=60
MINERU_UPLOAD_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=10
MINERU_POLL_TIMEOUT_SECONDS=1800

# ArXiv 原始资料获取
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
ARXIV_DATA_DIR=data/sources/arxiv
ARXIV_REQUEST_DELAY_SECONDS=3
ARXIV_TIMEOUT_SECONDS=30
ARXIV_DOWNLOAD_TIMEOUT_SECONDS=300
ARXIV_MAX_DOWNLOAD_MB=100
ARXIV_USER_AGENT=paper-rag/0.1 (https://github.com/YaoHui-Wu06022/PaperRAG)

# 正文检索链路的可选 JEV 任务分类（只在 Agent 选择 library_retrieve 后调用）
JEV_ENABLED=true
JEV_BASE_URL=https://jevmodel.org/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=15
JEV_RETRY_COUNT=2
JEV_ROUTE_PROBABILITY_THRESHOLD=0.65

# BM25 查询关键词改写（OpenAI 兼容 Chat Completions；默认复用 DashScope 配置）
QUERY_REWRITER_ENABLED=true
QUERY_REWRITER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QUERY_REWRITER_API_KEY=
QUERY_REWRITER_MODEL=deepseek-v4.1-flash
QUERY_REWRITER_TIMEOUT_SECONDS=15
QUERY_REWRITER_RETRY_COUNT=2

# MCP 工具组：默认启用 citation、fulltext；可用 none/all 或逗号分隔组名覆盖
PAPER_RAG_TOOLSETS=

# 本地 Catalog 派生索引
PAPER_CATALOG_DB_PATH=data/index/paper_catalog.sqlite3

# Milvus配置
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB_NAME=
MILVUS_COLLECTION=paper_rag_chunks
MILVUS_DIMENSION=1024

# LlamaIndex 向量索引
LLAMAINDEX_MILVUS_COLLECTION=paper_rag_llama_chunks
LLAMAINDEX_INDEX_DIR=data/index/llamaindex
LLAMAINDEX_RETRIEVAL_TOP_K=8
LLAMAINDEX_LEXICAL_TOP_K=50
LLAMAINDEX_SEMANTIC_TOP_K=50
LLAMAINDEX_RRF_K=60

# DashScope OpenAI 兼容 Embedding
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=20
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_RETRY_COUNT=2

# Agent/MCP 下载任务
MCP_JOB_LOG_PATH=data/index/mcp_jobs.jsonl
MCP_INDEX_STATE_PATH=data/index/index_state.json
PAPER_RAG_INPUT_ROOTS=
MCP_MAX_DOWNLOAD_MB=100

# BM25关键词翻译配置
BM25_TRANSLATION_ENABLED=true
BM25_TRANSLATION_TIMEOUT_SECONDS=5
BM25_TRANSLATION_RETRY_COUNT=1
BM25_TRANSLATION_MAX_CHARS=2000
TENCENT_TRANSLATE_SECRET_ID=
TENCENT_TRANSLATE_SECRET_KEY=
TENCENT_TRANSLATE_REGION=ap-shanghai
TENCENT_TRANSLATE_ENDPOINT=tmt.tencentcloudapi.com
ALIYUN_TRANSLATION_ENABLED=false
ALIYUN_TRANSLATION_ACCESS_KEY_ID=
ALIYUN_TRANSLATION_ACCESS_KEY_SECRET=
ALIYUN_TRANSLATION_SECURITY_TOKEN=
ALIYUN_TRANSLATION_REGION_ID=cn-hangzhou
ALIYUN_TRANSLATION_ENDPOINT=mt.cn-hangzhou.aliyuncs.com
