# MinerU is the PDF parser. Markdown notes need no parser service.
MINERU_API_KEY=
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=en

# Versioned local catalog and immutable source snapshots.
PAPER_LIBRARY_DIR=data/library

# The v2 namespace is independent of every legacy collection.
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB_NAME=
MILVUS_V2_COLLECTION=paper_library_v2

# Embedding only; no parser/answer/translation LLM credentials are used.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_DEPLOYMENT=
